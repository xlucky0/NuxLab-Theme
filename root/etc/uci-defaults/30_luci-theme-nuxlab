#!/bin/sh

# OPKG/APK may remove catalogs owned by the previous theme. Keep existing
# translations until a separate language package takes ownership of them.
i18n_backup=/etc/nuxlab-config-migration/i18n
if [ -d "$i18n_backup" ]; then
	mkdir -p /usr/lib/lua/luci/i18n || exit 1
	for catalog in "$i18n_backup"/nuxlab.*.lmo; do
		[ -f "$catalog" ] && [ ! -L "$catalog" ] || continue
		target="/usr/lib/lua/luci/i18n/${catalog##*/}"
		if [ ! -e "$target" ] && [ ! -L "$target" ]; then
			cp -p "$catalog" "$target" || exit 1
		fi
		rm -f "$catalog"
	done
	rmdir "$i18n_backup" 2>/dev/null || true
	rmdir /etc/nuxlab-config-migration 2>/dev/null || true
fi

# The empty legacy package saves its conffile before releasing file ownership.
if [ -f /etc/nuxlab-config-migration/nuxlab ]; then
	cp -p /etc/nuxlab-config-migration/nuxlab /etc/config/nuxlab || exit 1
	rm -f /etc/nuxlab-config-migration/nuxlab
	rmdir /etc/nuxlab-config-migration 2>/dev/null || true
fi

# Preserve configured values and migrate the old Bing switch only when needed.
[ -e /etc/config/nuxlab ] || touch /etc/config/nuxlab || exit 1
if ! uci -q get 'nuxlab.@global[0]' >/dev/null; then
	uci -q add nuxlab global >/dev/null
fi
old_bing="$(uci -q get 'nuxlab.@global[0].bing_background')"
if [ -n "$old_bing" ]; then
	if ! uci -q get 'nuxlab.@global[0].online_wallpaper' >/dev/null; then
		if [ "$old_bing" = 1 ]; then
			uci set 'nuxlab.@global[0].online_wallpaper=bing'
		else
			uci set 'nuxlab.@global[0].online_wallpaper=none'
		fi
	fi
	uci -q delete 'nuxlab.@global[0].bing_background'
fi
# Missing selectors identify old installations; preserve their separate choices.
if ! uci -q get 'nuxlab.@global[0].dark_primary_mode' >/dev/null; then
	if [ -n "$(uci -q get 'nuxlab.@global[0].dark_primary')" ]; then
		uci set 'nuxlab.@global[0].dark_primary_mode=custom'
	else
		uci set 'nuxlab.@global[0].dark_primary_mode=auto'
	fi
fi
if ! uci -q get 'nuxlab.@global[0].dark_glass_mode' >/dev/null; then
	light_blur="$(uci -q get 'nuxlab.@global[0].blur')"
	light_opacity="$(uci -q get 'nuxlab.@global[0].transparency')"
	dark_blur="$(uci -q get 'nuxlab.@global[0].blur_dark')"
	dark_opacity="$(uci -q get 'nuxlab.@global[0].transparency_dark')"
	if [ "${dark_blur:-${light_blur:-10}}" != "${light_blur:-10}" ] ||
		[ "${dark_opacity:-${light_opacity:-0.5}}" != "${light_opacity:-0.5}" ]; then
		uci set 'nuxlab.@global[0].dark_glass_mode=custom'
	else
		uci set 'nuxlab.@global[0].dark_glass_mode=inherit'
	fi
fi
while read -r option value; do
	uci -q get "nuxlab.@global[0].$option" >/dev/null ||
		uci set "nuxlab.@global[0].$option=$value"
done <<'DEFAULTS'
login_style classic
primary #4f46e5
dark_primary #00e5ff
blur 10
blur_dark 10
transparency 0.5
transparency_dark 0.5
mode normal
online_wallpaper none
DEFAULTS
uci commit nuxlab

if [ "$PKG_UPGRADE" != 1 ]; then
	uci get luci.themes.NuxLab >/dev/null 2>&1 || \
	uci batch <<-EOF
		set luci.themes.NuxLab=/luci-static/nuxlab
		set luci.main.mediaurlbase=/luci-static/nuxlab
		commit luci
	EOF
fi

exit 0
