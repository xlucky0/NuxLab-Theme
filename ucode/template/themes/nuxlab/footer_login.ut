{#
	NuxLab is a clean Cyberpunk Neon & Frost Indigo HTML5 theme for LuCI.
	Based on luci-theme-argon (Copyright 2020 Jerrykuku) and luci-theme-material.

	luci-theme-nuxlab
	https://github.com/xlucky0/luci-theme-nuxlab

	Licensed to the public under the Apache License 2.0
-#}

</div>
{%
	const luci_info = 'Powered by ' + version.luciname + ' (' + version.luciversion + ')';
	const firmware_info = version.distname + ' ' + version.distversion + '-' + version.distrevision;
%}
<footer>
	<div class="login-footer-links">
		<a href="https://github.com/openwrt/luci" target="_blank" title="{{ entityencode(luci_info, true) }}">{{ split(version.luciname, ' (')[0] }}</a>
		<a href="https://github.com/xlucky0/luci-theme-nuxlab" target="_blank">NuxLab {# vPKG_VERSION #}</a>
	</div>
	<a href="{{ version.disturl }}" target="_blank" title="{{ entityencode(firmware_info, true) }}">{{ firmware_info }}</a>
</footer>
</main>
</div>
{% include('themes/' + theme + '/page_scripts', { is_login: true }) %}
</body>
</html>
